# ─────────────────────────────────────────────────────────────────────────────
# TAWA — environment configuration (copy to .env or export in your process env)
# Every setting has a safe development default. NOTHING below is required for
# local evaluation: `node server/index.js --seed` works with zero config.
# NEVER commit a real .env or real secrets (already covered by .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# Runtime environment: development | production
TAWA_ENV=development

# HTTP bind. The container/preview images bind 0.0.0.0; use 127.0.0.1 for a
# strictly local-only instance.
HOST=0.0.0.0
PORT=8080

# Storage. The SQLite database lives at TAWA_DB_FILE (WAL mode).
# TAWA_DB_FILE defaults to <TAWA_DATA_DIR>/tawa.db.
# In Docker, mount a volume at TAWA_DATA_DIR (the image uses /data).
TAWA_DATA_DIR=./data
# TAWA_DB_FILE=./data/tawa.db

# Sessions (server-side, bearer token AND HttpOnly cookie are both accepted).
TAWA_SESSION_TTL_HOURS=12
# Set true when serving over HTTPS so the cookie is marked Secure.
TAWA_COOKIE_SECURE=false

# Webhook signing secrets — HMAC shared secrets used to verify provider
# callbacks (payment webhooks). The built-in values are SANDBOX-ONLY defaults;
# production deployments MUST override these via a secret manager / env.
TAWA_WEBHOOK_SECRET_MPESA=sandbox-whsec-mpesa-local-dev-only
TAWA_WEBHOOK_SECRET_CARD=sandbox-whsec-card-local-dev-only
# Optional: when set, platform-control-plane requests must also send header
# `x-tawa-internal: <secret>` (defence in depth for the admin plane).
# TAWA_ADMIN_BOOTSTRAP_SECRET=

# Optional: set to 1 when running behind your own TLS-terminating proxy that
# strips inbound X-Forwarded-For headers. Direct exposure without a proxy that
# sanitizes XFF lets callers spoof rate-limit buckets — see docs/SECURITY.md.
# TAWA_TRUST_PROXY=0
